<UserControl x:Class="Lab04_Valeriano.Views.ProveedorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lab04_Valeriano.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
    <UserControl.DataContext>
        <vm:ProveedorViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Contacto:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding FiltroNombreContacto, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,10,0"/>
            <TextBlock Text="Ciudad:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,10,0"/>
            <Button Content="Buscar" Command="{Binding BuscarCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Proveedores}"
                      SelectedItem="{Binding ProveedorSeleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,10,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="50"/>
                    <DataGridTextColumn Header="Compania" Binding="{Binding CompaniaNombre}" Width="150"/>
                    <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="120"/>
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="100"/>
                    <DataGridTextColumn Header="Pais" Binding="{Binding Pais}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Compania"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.CompaniaNombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Nombre Contacto"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.NombreContacto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Cargo Contacto"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.CargoContacto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Direccion"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.Direccion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Ciudad"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.Ciudad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Codigo Postal"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.CodigoPostal, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Pais"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.Pais, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Telefono"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.Telefono, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Fax"/>
                    <TextBox Text="{Binding ProveedorSeleccionado.Fax, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <UniformGrid Columns="2" Rows="2">
                        <Button Content="Cargar" Command="{Binding CargarCommand}" Margin="2"/>
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}" Margin="2"/>
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="2"/>
                        <Button Content="Eliminar" Command="{Binding EliminarCommand}" Margin="2"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
